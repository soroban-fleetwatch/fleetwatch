{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "statement": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "network_passphrase_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_contract": {
          "type": "string",
          "pattern": "^C[A-Z2-7]{55}$"
        },
        "tag_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$",
          "maxLength": 2048
        },
        "from_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "to_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "reviewed_artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "valid_from_ledger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "valid_until_ledger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "network_passphrase_hash",
        "owner_contract",
        "tag_hex",
        "from_hash",
        "to_hash",
        "ticket",
        "reviewed_artifact_digest",
        "valid_from_ledger",
        "valid_until_ledger",
        "nonce"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_base64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{86}==$"
          }
        },
        "required": [
          "key_id",
          "signature_base64"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "statement",
    "signatures"
  ],
  "additionalProperties": false
}
