{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental follow operational status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "code", "ready", "processed_through", "endpoint_head", "endpoint_ledger_lag", "retained_ledgers", "retained_payload_bytes", "pending_findings", "polls", "gap_episodes", "last_successful_cycle_unix", "source_authentication", "baseline_authentication", "metadata_commitment", "membership_coverage", "history_completeness", "final_verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "EXPERIMENTAL_READ_ONLY_FOLLOW"},
    "code": {"enum": ["STARTING", "IDLE", "FOLLOWING", "SOURCE_UNAVAILABLE", "EVIDENCE_REJECTED", "CAPACITY_REACHED", "STATE_FAILURE", "STOPPED", "OUTBOX_SYNC_FAILED"]},
    "ready": {"type": "boolean"},
    "processed_through": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "endpoint_head": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
    "endpoint_ledger_lag": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295},
    "retained_ledgers": {"type": "integer", "minimum": 0},
    "retained_payload_bytes": {"type": "integer", "minimum": 0},
    "pending_findings": {"type": "integer", "minimum": 0, "maximum": 10000},
    "polls": {"type": "integer", "minimum": 0},
    "gap_episodes": {"type": "integer", "minimum": 0},
    "last_successful_cycle_unix": {"type": "integer", "minimum": 0},
    "source_authentication": {"const": "UNVERIFIED"},
    "baseline_authentication": {"const": "UNVERIFIED"},
    "metadata_commitment": {"const": "NOT_VERIFIED"},
    "membership_coverage": {"const": "UNKNOWN"},
    "history_completeness": {"const": "UNKNOWN"},
    "final_verdict": {"const": "UNDETERMINED"}
  }
}
