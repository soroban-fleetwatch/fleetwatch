{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FleetWatch local backup receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bytes",
    "sha256",
    "storage_format",
    "semantic_validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_format": {
      "const": "BBOLT_TRANSACTION_SNAPSHOT"
    },
    "semantic_validation": {
      "const": "NOT_PERFORMED"
    }
  }
}
