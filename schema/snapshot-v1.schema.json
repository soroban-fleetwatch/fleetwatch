{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "network": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ledger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "executable": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "wasm",
                  "external_ref",
                  "stellar_asset"
                ]
              },
              "wasm_hash": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "tag_hex": {
                "type": "string",
                "pattern": "^(?:[a-fA-F0-9]{2})+$",
                "maxLength": 2048
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "wasm"
                  }
                },
                "required": [
                  "wasm_hash"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "owner"
                      ]
                    },
                    {
                      "required": [
                        "tag_hex"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "external_ref"
                  }
                },
                "required": [
                  "owner",
                  "tag_hex"
                ],
                "not": {
                  "required": [
                    "wasm_hash"
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "stellar_asset"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "owner"
                      ]
                    },
                    {
                      "required": [
                        "tag_hex"
                      ]
                    },
                    {
                      "required": [
                        "wasm_hash"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "executable"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tag_hex": {
            "type": "string",
            "pattern": "^(?:[a-fA-F0-9]{2})+$",
            "maxLength": 2048
          },
          "wasm_hash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "owner",
          "tag_hex",
          "wasm_hash"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "network",
    "ledger"
  ],
  "additionalProperties": false
}
