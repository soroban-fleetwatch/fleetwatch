{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source": {
      "const": "rpc_current"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "fleet_scope": {
      "const": "EXPLICIT_WATCHLIST"
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C[A-Z2-7]{55}$"
      },
      "maxItems": 50,
      "minItems": 1,
      "uniqueItems": true
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "ledger_consistency": {
      "enum": [
        "UNKNOWN",
        "INCONSISTENT",
        "SINGLE_RESPONSE_CLAIM"
      ]
    },
    "history_completeness": {
      "const": "UNKNOWN"
    },
    "source_authentication": {
      "const": "UNVERIFIED"
    },
    "head": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": 28
        },
        "closeTime": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "sequence",
        "protocolVersion",
        "closeTime"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "network": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ledger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "executable": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "wasm",
                      "external_ref",
                      "stellar_asset"
                    ]
                  },
                  "wasm_hash": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "tag_hex": {
                    "type": "string",
                    "pattern": "^(?:[a-fA-F0-9]{2})+$",
                    "maxLength": 2048
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "properties": {
                      "kind": {
                        "const": "wasm"
                      }
                    },
                    "required": [
                      "wasm_hash"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "owner"
                          ]
                        },
                        {
                          "required": [
                            "tag_hex"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "external_ref"
                      }
                    },
                    "required": [
                      "owner",
                      "tag_hex"
                    ],
                    "not": {
                      "required": [
                        "wasm_hash"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "stellar_asset"
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "owner"
                          ]
                        },
                        {
                          "required": [
                            "tag_hex"
                          ]
                        },
                        {
                          "required": [
                            "wasm_hash"
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "executable"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "tag_hex": {
                "type": "string",
                "pattern": "^(?:[a-fA-F0-9]{2})+$",
                "maxLength": 2048
              },
              "wasm_hash": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            },
            "required": [
              "owner",
              "tag_hex",
              "wasm_hash"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "schema_version",
        "network",
        "ledger"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key_xdr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          },
          "data_xdr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "response_ledger": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "last_modified_ledger": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "key_xdr",
          "data_xdr",
          "raw_sha256",
          "response_ledger",
          "last_modified_ledger"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 500
    }
  },
  "required": [
    "schema_version",
    "source",
    "collected_at",
    "fleet_scope",
    "watchlist",
    "completeness",
    "ledger_consistency",
    "history_completeness",
    "source_authentication",
    "head",
    "snapshot",
    "evidence",
    "errors"
  ],
  "additionalProperties": false
}
