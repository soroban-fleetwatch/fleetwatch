{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FleetWatch alert recovery result v1",
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "alert_id",
        "request_id",
        "expected_cycle",
        "reason",
        "network",
        "source",
        "payload_sha256",
        "previous_status",
        "previous_attempts",
        "sink",
        "recovery_cycle",
        "recovered_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "alert_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "expected_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "synthetic",
            "user_snapshot",
            "rpc_ledger_meta"
          ]
        },
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_status": {
          "enum": [
            "DEAD",
            "INFLIGHT"
          ]
        },
        "previous_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "previous_error_code": {
          "type": "string"
        },
        "previous_lease_until": {
          "type": "integer",
          "minimum": 1
        },
        "sink": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recovery_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "recovered_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "rpc_ledger_meta"
              }
            }
          },
          "then": {
            "required": [
              "stream"
            ]
          },
          "else": {
            "not": {
              "required": [
                "stream"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "previous_status": {
                "const": "INFLIGHT"
              }
            }
          },
          "then": {
            "required": [
              "previous_lease_until"
            ],
            "properties": {
              "previous_attempts": {
                "const": 5
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "previous_lease_until"
              ]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "new_recovery",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "new_recovery": {
      "type": "boolean"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    }
  }
}
